// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Instance {
    id          Int       @id @default(autoincrement())
    createdAt   DateTime  @default(now())
    createdById Int
    updatedAt   DateTime  @updatedAt
    updatedById Int
    deletedAt   DateTime?
    deletedById Int?

    name        String
    alias       String
    description String?
    active      Boolean @default(true)

    userInstances UserInstance[]

    @@map("instance")
}

model User {
    id          Int       @id @default(autoincrement())
    createdAt   DateTime  @default(now())
    createdById Int
    updatedAt   DateTime  @updatedAt
    updatedById Int
    deletedAt   DateTime?
    deletedById Int?

    firstName  String
    middleName String?
    lastName   String
    email      String  @unique
    password   String
    active     Boolean @default(true)

    userInstances UserInstance[]
    userRoles     UserRole[]

    @@map("user")
}

model UserInstance {
    id          Int       @id @default(autoincrement())
    createdAt   DateTime  @default(now())
    createdById Int
    updatedAt   DateTime  @updatedAt
    updatedById Int
    deletedAt   DateTime?
    deletedById Int?

    fkUserId Int
    user     User @relation(fields: [fkUserId], references: [id])

    fkInstanceId Int
    instance     Instance @relation(fields: [fkInstanceId], references: [id])

    @@map("user_instance")
}

model Role {
    id          Int       @id @default(autoincrement())
    createdAt   DateTime  @default(now())
    createdById Int
    updatedAt   DateTime  @updatedAt
    updatedById Int
    deletedAt   DateTime?
    deletedById Int?

    name        String
    description String?

    userRoles       UserRole[]
    rolePermissions RolePermission[]

    @@map("role")
}

model UserRole {
    id          Int       @id @default(autoincrement())
    createdAt   DateTime  @default(now())
    createdById Int
    updatedAt   DateTime  @updatedAt
    updatedById Int
    deletedAt   DateTime?
    deletedById Int?

    fkRoleId Int
    role     Role @relation(fields: [fkRoleId], references: [id])

    fkUserId Int
    user     User @relation(fields: [fkUserId], references: [id])

    @@map("user_role")
}

model Permission {
    id          Int       @id @default(autoincrement())
    createdAt   DateTime  @default(now())
    createdById Int
    updatedAt   DateTime  @updatedAt
    updatedById Int
    deletedAt   DateTime?
    deletedById Int?

    action      String  @unique
    description String?

    rolePermissions RolePermission[]

    @@map("permission")
}

model RolePermission {
    id          Int       @id @default(autoincrement())
    createdAt   DateTime  @default(now())
    createdById Int
    updatedAt   DateTime  @updatedAt
    updatedById Int
    deletedAt   DateTime?
    deletedById Int?

    fkRoleId Int
    role     Role @relation(fields: [fkRoleId], references: [id])

    fkPermissionId Int
    permission     Permission @relation(fields: [fkPermissionId], references: [id])

    @@map("role_permission")
}
